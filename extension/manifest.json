{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "SAYNO – Card Guard",
  "short_name": "SAYNO",
  "version": "1.1.0",
  "description": "Blocks fake bank pages before you type your card and checks suspicious messages. Everything is checked on your device.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAYNO",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "banks.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/tokens.css",
        "ui/components.css",
        "ui/overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "optional_permissions": [
    "notifications"
  ]
}